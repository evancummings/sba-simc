<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SBA SimC — Optimal vs Assisted Highlight vs One Button Rotation</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #0e0e12;
      color: #d4d4d8;
      min-height: 100vh;
      padding: 1.25rem 1rem;
    }

    header {
      max-width: 1400px;
      margin: 0 auto 1rem;
    }

    h1 {
      font-size: 1.4rem;
      font-weight: 700;
      color: #f4f4f5;
      margin-bottom: .3rem;
    }

    .subtitle {
      font-size: .82rem;
      color: #71717a;
    }

    .subtitle a { color: #a1a1aa; }

    .subtitle code {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: .78rem;
      color: #a1a1aa;
    }

    /* Summary pills */
    .summary {
      display: flex;
      gap: .75rem;
      flex-wrap: wrap;
      margin: .9rem 0;
    }

    .pill {
      padding: .35rem .85rem;
      border-radius: 9999px;
      font-size: .8rem;
      font-weight: 600;
      letter-spacing: .02em;
    }

    .pill-good     { background: #14532d; color: #86efac; }
    .pill-moderate { background: #713f12; color: #fde68a; }
    .pill-poor     { background: #7f1d1d; color: #fca5a5; }
    .pill-broken   { background: #422006; color: #fdba74; border: 1px solid #9a3412; }
    .pill-total    { background: #1e1e2e; color: #a1a1aa; border: 1px solid #3f3f46; }

    tr.apl-broken { background: rgba(154, 52, 18, 0.08); }
    tr.apl-broken:hover { background: rgba(154, 52, 18, 0.14); }

    .apl-broken-badge {
      display: inline-block;
      padding: .1rem .4rem;
      border-radius: 4px;
      font-size: .68rem;
      font-weight: 600;
      letter-spacing: .02em;
      color: #fdba74;
      background: rgba(154, 52, 18, 0.35);
      border: 1px solid rgba(251, 146, 60, 0.35);
      vertical-align: middle;
    }

    .delta-unreliable { color: #71717a; font-weight: 500; }

    /* Class filter */
    .filters {
      max-width: 1400px;
      margin: 0 auto 1rem;
      display: flex;
      flex-wrap: wrap;
      gap: .5rem;
      align-items: center;
    }

    .filter-label { font-size: .8rem; color: #71717a; margin-right: .25rem; }

    .filter-btn {
      padding: .3rem .75rem;
      border-radius: 6px;
      border: 1px solid #3f3f46;
      background: #18181b;
      color: #a1a1aa;
      font-size: .8rem;
      cursor: pointer;
      transition: background .15s, color .15s, border-color .15s;
    }

    .filter-btn:hover,
    .filter-btn.active {
      background: #3f3f46;
      color: #f4f4f5;
      border-color: #52525b;
    }

    /* Table */
    .table-wrap {
      max-width: 1400px;
      margin: 0 auto;
      overflow-x: auto;
      border-radius: 10px;
      border: 1px solid #27272a;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: .8rem;
    }

    thead tr {
      background: #18181b;
      border-bottom: 1px solid #27272a;
    }

    thead tr.header-groups {
      border-bottom: none;
    }

    th.col-group {
      text-align: center;
      cursor: default;
      color: #d4d4d8;
      border-bottom: 1px solid #27272a;
    }

    th.col-group:hover { color: #d4d4d8; }

    thead tr.header-columns th {
      font-weight: 500;
      font-size: .75rem;
    }

    th.col-divider,
    td.col-divider {
      border-left: 2px solid #52525b;
    }

    th {
      padding: .55rem .7rem;
      text-align: left;
      font-weight: 600;
      color: #a1a1aa;
      cursor: pointer;
      user-select: none;
      white-space: nowrap;
    }

    th:hover { color: #f4f4f5; }
    th.sorted { color: #f4f4f5; }
    th .sort-arrow { margin-left: .25rem; opacity: .5; font-size: .7rem; }
    th.sorted .sort-arrow { opacity: 1; }

    tbody tr {
      border-bottom: 1px solid #1f1f23;
      transition: background .1s;
    }

    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: #18181b; }
    tbody tr.hidden { display: none; }
    tbody tr.clickable { cursor: pointer; }
    tbody tr.clickable:hover { background: rgba(63, 63, 70, 0.35); }

    td { padding: .45rem .7rem; white-space: nowrap; }

    .class-badge {
      display: inline-block;
      padding: .15rem .55rem;
      border-radius: 5px;
      font-size: .75rem;
      font-weight: 600;
      background: #27272a;
      color: #d4d4d8;
    }

    .dps { font-variant-numeric: tabular-nums; text-align: right; }
    .dps.dps-unreliable { text-align: center; }

    .delta {
      font-variant-numeric: tabular-nums;
      font-weight: 700;
      text-align: right;
      white-space: nowrap;
    }

    .delta-good     { color: #4ade80; }
    .delta-moderate { color: #fbbf24; }
    .delta-poor     { color: #f87171; }

    footer {
      max-width: 1400px;
      margin: 2rem auto 0;
      font-size: .78rem;
      color: #52525b;
      text-align: center;
    }
  </style>
</head>
<body>

<header>
  <h1>⚔️ SBA SimC — Optimal vs Assisted Highlight vs One Button Rotation</h1>
  <p class="subtitle">
    Comparing the SimulationCraft community-optimal APL against Blizzard's Assisted Highlight (no GCD penalty)
    and One Button Rotation (with GCD penalty), for every class/spec/hero-talent combination.
    <br />
    Fight profile: <strong id="fight-profile-label">{{ default_fight_profile_id }}</strong> &mdash;
    SimC version: <strong>{{ simc_version }}</strong> &mdash;
    Docker: <strong>{{ docker_image }}</strong>{{ if docker_digest_short }} @ <code title="{{ docker_digest }}">{{ docker_digest_short }}</code>{{ else if docker_image_id }} (id {{ docker_image_id }}){{ end }} &mdash;
    {{ iterations | math.format "N0" }} iterations per sim.
  </p>

  <div class="summary" id="summary-pills">
    <span class="pill pill-total" id="pill-total">{{ total_specs }} combinations</span>
    <span class="pill pill-good" id="pill-good">✓ {{ good_count }} within 5%</span>
    <span class="pill pill-moderate" id="pill-moderate">~ {{ moderate_count }} within 5–15%</span>
    <span class="pill pill-poor" id="pill-poor">✗ {{ poor_count }} over 15% loss</span>
    <span class="pill pill-broken" id="pill-broken"{{ if broken_apl_count == 0 }} style="display:none"{{ end }}>⚠ {{ broken_apl_count }} broken SimC APL</span>
  </div>
</header>

<div class="filters">
  <span class="filter-label">Fight profile:</span>
  {{- for fp in fight_profiles }}
  <button type="button" class="filter-btn profile-btn{{ if fp.id == default_fight_profile_id }} active{{ end }}" data-profile="{{ fp.id }}" title="{{ fp.description }}">{{ fp.label }}</button>
  {{- end }}
</div>

<div class="filters">
  <span class="filter-label">Filter by class:</span>
  <button class="filter-btn active" data-class="all" onclick="filterClass(this, 'all')">All</button>
  {{- for cls in classes }}
  <button class="filter-btn" data-class="{{ cls }}" onclick="filterClass(this, '{{ cls }}')">{{ cls }}</button>
  {{- end }}
</div>

<div class="table-wrap">
  <table id="results-table">
    <thead>
      <tr class="header-groups">
        <th rowspan="2" data-col="0" onclick="sortTable(0)">Class <span class="sort-arrow">↕</span></th>
        <th rowspan="2" data-col="1" onclick="sortTable(1)">Spec <span class="sort-arrow">↕</span></th>
        <th rowspan="2" data-col="2" onclick="sortTable(2)">Hero Talent <span class="sort-arrow">↕</span></th>
        <th class="col-group col-divider">SimC</th>
        <th colspan="2" class="col-group col-divider">Assisted Highlight</th>
        <th colspan="2" class="col-group col-divider">One Button Rotation</th>
      </tr>
      <tr class="header-columns">
        <th data-col="3" class="col-divider" onclick="sortTable(3)" style="text-align:right" title="SimulationCraft optimal APL DPS">DPS <span class="sort-arrow">↕</span></th>
        <th data-col="4" class="col-divider" onclick="sortTable(4)" style="text-align:right" title="Assisted Highlight DPS (Blizzard APL, no GCD penalty)">DPS <span class="sort-arrow">↕</span></th>
        <th data-col="5" onclick="sortTable(5)" style="text-align:right" title="Assisted Highlight delta vs SimC APL">Δ <span class="sort-arrow">↕</span></th>
        <th data-col="6" class="col-divider" onclick="sortTable(6)" style="text-align:right" title="One Button Rotation DPS (Blizzard APL + GCD penalty)">DPS <span class="sort-arrow">↕</span></th>
        <th data-col="7" onclick="sortTable(7)" style="text-align:right" title="One Button Rotation delta vs SimC APL">Δ <span class="sort-arrow">↕</span></th>
      </tr>
    </thead>
    <tbody>
      {{- for r in results }}
      {{- severity_class = ""
          if r.severity == 0
            severity_class = "delta-good"
          else if r.severity == 1
            severity_class = "delta-moderate"
          else
            severity_class = "delta-poor"
          end
          ob_severity_class = ""
          if r.one_button_severity == 0
            ob_severity_class = "delta-good"
          else if r.one_button_severity == 1
            ob_severity_class = "delta-moderate"
          else
            ob_severity_class = "delta-poor"
          end }}
      <tr data-class="{{ r.spec.class }}" data-slug="{{ r.detail_slug }}"{{ if r.likely_broken_apl }} class="apl-broken{{ if r.has_detail_page }} clickable{{ end }}"{{ else if r.has_detail_page }} class="clickable"{{ end }}{{ if r.has_detail_page }} data-href="details/{{ r.detail_slug }}.html" data-has-detail="1"{{ end }}>
        <td><span class="class-badge">{{ r.spec.class }}</span></td>
        <td>{{ r.spec.spec }}</td>
        <td>{{ r.spec.hero_talent }}</td>
        <td class="dps col-divider" data-val="{{ r.optimal_dps | math.round }}">{{ r.optimal_dps | math.round }}</td>
        <td class="dps col-divider{{ if r.likely_broken_apl }} dps-unreliable{{ end }}" data-val="{{ if r.likely_broken_apl }}-9999{{ else }}{{ r.assisted_highlight_dps | math.round }}{{ end }}">
          {{- if r.likely_broken_apl }}
          <span class="apl-broken-badge">⚠ APL Missing</span>
          {{- else }}
          {{ r.assisted_highlight_dps | math.round }}
          {{- end }}
        </td>
        <td class="delta {{ if r.likely_broken_apl }}delta-unreliable{{ else }}{{ severity_class }}{{ end }}" data-val="{{ if r.likely_broken_apl }}-9999{{ else }}{{ r.delta_percent }}{{ end }}" title="{{ if r.likely_broken_apl }}SimC's assisted_combat APL appears broken for this profile (AH DPS &lt; 50% of optimal). Delta is not meaningful.{{ end }}">
          {{- if !r.likely_broken_apl }}
          {{ r.delta_formatted }}
          {{- end }}
        </td>
        <td class="dps col-divider{{ if r.likely_broken_apl }} dps-unreliable{{ end }}" data-val="{{ if r.likely_broken_apl }}-9999{{ else }}{{ r.one_button_dps | math.round }}{{ end }}">
          {{- if r.likely_broken_apl }}
          <span class="apl-broken-badge">⚠ APL Missing</span>
          {{- else }}
          {{ r.one_button_dps | math.round }}
          {{- end }}
        </td>
        <td class="delta {{ if r.likely_broken_apl }}delta-unreliable{{ else }}{{ ob_severity_class }}{{ end }}" data-val="{{ if r.likely_broken_apl }}-9999{{ else }}{{ r.one_button_delta_percent }}{{ end }}" title="{{ if r.likely_broken_apl }}SimC's assisted_combat APL appears broken for this profile. Delta is not meaningful.{{ end }}">
          {{- if !r.likely_broken_apl }}
          {{ r.one_button_delta_formatted }}
          {{- end }}
        </td>
      </tr>
      {{- end }}
    </tbody>
  </table>
</div>

<footer>
  Generated {{ generated_at }} &mdash;
  <a href="https://github.com/simulationcraft/simc" style="color:#52525b">SimulationCraft</a> &mdash;
  <a href="{{ docker_hub_url }}" style="color:#52525b" title="{{ docker_image_label }}">{{ docker_link_label }}</a> &mdash;
  <a href="https://github.com/evancummings/sba-simc" style="color:#52525b">Source</a>
</footer>

<script type="application/json" id="index-data">{{ index_data_json }}</script>
<script>
  const indexData = JSON.parse(document.getElementById('index-data').textContent);
  let activeProfile = '{{ default_fight_profile_id }}';
  const CLASS_COLORS = {
    'Death Knight': '#C41E3A',
    'Demon Hunter': '#A330C9',
    'Druid':        '#FF7C0A',
    'Evoker':       '#33937F',
    'Hunter':       '#AAD372',
    'Mage':         '#3FC7EB',
    'Monk':         '#00FF98',
    'Paladin':      '#F48CBA',
    'Priest':       '#F0EDD4',
    'Rogue':        '#FFF468',
    'Shaman':       '#0070DD',
    'Warlock':      '#8788EE',
    'Warrior':      '#C69B3A',
  };

  function hexToRgb(hex) {
    return {
      r: parseInt(hex.slice(1, 3), 16),
      g: parseInt(hex.slice(3, 5), 16),
      b: parseInt(hex.slice(5, 7), 16),
    };
  }

  const fmt = new Intl.NumberFormat('en-US');

  function severityClass(severity) {
    if (severity === 0) return 'delta-good';
    if (severity === 1) return 'delta-moderate';
    return 'delta-poor';
  }

  function formatDelta(pct) {
    return (pct >= 0 ? '+' : '') + pct.toFixed(1) + '%';
  }

  function updateSummaryPills(profileId) {
    const s = indexData.summaries[profileId];
    if (!s) return;
    document.getElementById('pill-total').textContent = `${s.total} combinations`;
    document.getElementById('pill-good').textContent = `✓ ${s.good} within 5%`;
    document.getElementById('pill-moderate').textContent = `~ ${s.moderate} within 5–15%`;
    document.getElementById('pill-poor').textContent = `✗ ${s.poor} over 15% loss`;
    const brokenPill = document.getElementById('pill-broken');
    if (s.broken > 0) {
      brokenPill.style.display = '';
      brokenPill.textContent = `⚠ ${s.broken} broken SimC APL`;
    } else {
      brokenPill.style.display = 'none';
    }
  }

  function updateRowForProfile(row, profileId) {
    const rowData = indexData.rows.find(r => r.slug === row.dataset.slug);
    if (!rowData) return;
    const p = rowData.byProfile[profileId];
    if (!p) return;

    row.classList.toggle('apl-broken', p.likelyBrokenApl);

    const optCell = row.cells[3];
    optCell.dataset.val = Math.round(p.optimalDps);
    optCell.textContent = fmt.format(Math.round(p.optimalDps));

    const ahCell = row.cells[4];
    const ahDeltaCell = row.cells[5];
    const obCell = row.cells[6];
    const obDeltaCell = row.cells[7];

    if (p.likelyBrokenApl) {
      ahCell.className = 'dps col-divider dps-unreliable';
      ahCell.dataset.val = '-9999';
      ahCell.innerHTML = '<span class="apl-broken-badge">⚠ APL Missing</span>';
      ahDeltaCell.className = 'delta delta-unreliable';
      ahDeltaCell.dataset.val = '-9999';
      ahDeltaCell.textContent = '';
      obCell.className = 'dps col-divider dps-unreliable';
      obCell.dataset.val = '-9999';
      obCell.innerHTML = '<span class="apl-broken-badge">⚠ APL Missing</span>';
      obDeltaCell.className = 'delta delta-unreliable';
      obDeltaCell.dataset.val = '-9999';
      obDeltaCell.textContent = '';
    } else {
      ahCell.className = 'dps col-divider';
      ahCell.dataset.val = Math.round(p.assistedHighlightDps);
      ahCell.textContent = fmt.format(Math.round(p.assistedHighlightDps));
      ahDeltaCell.className = `delta ${severityClass(p.severity)}`;
      ahDeltaCell.dataset.val = p.deltaPercent;
      ahDeltaCell.textContent = formatDelta(p.deltaPercent);
      obCell.className = 'dps col-divider';
      obCell.dataset.val = Math.round(p.oneButtonDps);
      obCell.textContent = fmt.format(Math.round(p.oneButtonDps));
      obDeltaCell.className = `delta ${severityClass(p.oneButtonSeverity)}`;
      obDeltaCell.dataset.val = p.oneButtonDeltaPercent;
      obDeltaCell.textContent = formatDelta(p.oneButtonDeltaPercent);
    }

    if (row.dataset.hasDetail === '1') {
      row.dataset.href = `details/${row.dataset.slug}.html?profile=${profileId}`;
    }
  }

  function applyFightProfile(btn, profileId) {
    activeProfile = profileId;
    document.querySelectorAll('.profile-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const profile = indexData.profiles.find(p => p.id === profileId);
    if (profile) {
      document.getElementById('fight-profile-label').textContent = profile.label;
    }
    updateSummaryPills(profileId);
    document.querySelectorAll('#results-table tbody tr').forEach(row => updateRowForProfile(row, profileId));
    sortTable(sortCol);
  }

  document.querySelectorAll('.profile-btn').forEach(btn => {
    btn.addEventListener('click', () => applyFightProfile(btn, btn.dataset.profile));
  });

  const initialProfileBtn = document.querySelector(`.profile-btn[data-profile="${activeProfile}"]`);
  if (initialProfileBtn) {
    document.getElementById('fight-profile-label').textContent =
      indexData.profiles.find(p => p.id === activeProfile)?.label || activeProfile;
  }

  document.querySelectorAll('#results-table tbody tr').forEach(row => updateRowForProfile(row, activeProfile));

  document.querySelectorAll('td.dps').forEach(td => {
    const v = parseFloat(td.dataset.val);
    if (isNaN(v) || v < 0) return;
    td.textContent = fmt.format(Math.round(v));
  });

  // Apply class colors to table badges
  document.querySelectorAll('.class-badge').forEach(badge => {
    const color = CLASS_COLORS[badge.textContent.trim()];
    if (!color) return;
    const { r, g, b } = hexToRgb(color);
    badge.style.color = color;
    badge.style.background = `rgba(${r},${g},${b},0.15)`;
  });

  // Apply class colors to filter buttons (idle state)
  function applyIdleStyle(btn) {
    const color = CLASS_COLORS[btn.dataset.class];
    if (!color) { btn.style.color = ''; btn.style.borderColor = ''; btn.style.background = ''; return; }
    btn.style.color = color;
    btn.style.borderColor = color + '55';
    btn.style.background = '';
  }

  function applyActiveStyle(btn) {
    const color = CLASS_COLORS[btn.dataset.class];
    if (!color) { btn.style.color = ''; btn.style.borderColor = ''; btn.style.background = ''; return; }
    const { r, g, b } = hexToRgb(color);
    btn.style.color = color;
    btn.style.borderColor = color;
    btn.style.background = `rgba(${r},${g},${b},0.18)`;
  }

  document.querySelectorAll('.filter-btn[data-class]').forEach(btn => {
    applyIdleStyle(btn);
  });

  // Class filter
  let activeClass = 'all';
  function filterClass(btn, cls) {
    activeClass = cls;
    document.querySelectorAll('.filter-btn[data-class]').forEach(b => {
      b.classList.remove('active');
      applyIdleStyle(b);
    });
    btn.classList.add('active');
    applyActiveStyle(btn);
    document.querySelectorAll('#results-table tbody tr').forEach(row => {
      row.classList.toggle('hidden', cls !== 'all' && row.dataset.class !== cls);
    });
  }

  // Sort
  let sortCol = 5, sortAsc = true; // pre-set so first sortTable(5) call flips to descending
  function sortTable(col) {
    const table = document.getElementById('results-table');
    const tbody = table.querySelector('tbody');
    const rows  = Array.from(tbody.querySelectorAll('tr'));

    if (sortCol === col) sortAsc = !sortAsc;
    else { sortCol = col; sortAsc = true; }

    rows.sort((a, b) => {
      const aCell = a.cells[col];
      const bCell = b.cells[col];
      const aVal  = aCell.dataset.val ?? aCell.textContent.trim();
      const bVal  = bCell.dataset.val ?? bCell.textContent.trim();
      const aNum  = parseFloat(aVal);
      const bNum  = parseFloat(bVal);
      const cmp   = isNaN(aNum) || isNaN(bNum)
        ? aVal.localeCompare(bVal)
        : aNum - bNum;
      return sortAsc ? cmp : -cmp;
    });

    rows.forEach(r => tbody.appendChild(r));
    filterClass(document.querySelector(`.filter-btn[data-class="${activeClass}"]`), activeClass);

    // Update arrow indicators
    document.querySelectorAll('th[data-col]').forEach(th => {
      const i = parseInt(th.dataset.col, 10);
      th.classList.toggle('sorted', i === col);
      const arrow = th.querySelector('.sort-arrow');
      if (arrow) arrow.textContent = i === col ? (sortAsc ? '↑' : '↓') : '↕';
    });
  }

  // Default sort: AH delta descending (closest to optimal at top; broken rows sort last via -9999)
  sortTable(5);

  // Detail page navigation
  document.querySelectorAll('#results-table tbody tr[data-has-detail]').forEach(row => {
    row.addEventListener('click', (e) => {
      if (e.target.closest('a')) return;
      window.location.href = row.dataset.href;
    });
  });
</script>
</body>
</html>
